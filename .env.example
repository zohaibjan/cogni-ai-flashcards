# Copy to .env.local for controlled local evaluation. Never commit populated values.
# The current prototype calls Gemini directly; EXPO_PUBLIC_* values are visible in
# client bundles. Use your own restricted test key. Production needs a backend proxy.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional legacy Supabase/RevenueCat experiments (not the current generation path).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Privileged Supabase service-role and LLM provider keys belong server-side only.
